{
  "name": "<PROJECT_NAME>-server",
  "description": "<PROJECT_DESCRIPTION>",
  "version": "1.0.0",
  "author": "Artem_Zhyto <https://github.com/ArtemZhyto>",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "npm run --workspaces --if-present test",
    "build": "npm run --workspaces --if-present build",
    "dev": "node scripts/compose.mjs dev up --build",
    "dev:down": "node scripts/compose.mjs dev down --remove-orphans",
    "dev:logs": "node scripts/compose.mjs dev logs -f",
    "prod": "node scripts/compose.mjs prod up -d --build",
    "prod:down": "node scripts/compose.mjs prod down --remove-orphans",
    "prod:logs": "node scripts/compose.mjs prod logs -f",
    "docker:dev": "node scripts/compose.mjs dev up --build",
    "docker:dev:down": "node scripts/compose.mjs dev down --remove-orphans",
    "docker:prod": "node scripts/compose.mjs prod up -d --build",
    "docker:prod:down": "node scripts/compose.mjs prod down --remove-orphans"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^17.4.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.4.0"
  }
}
