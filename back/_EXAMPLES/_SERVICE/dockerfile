FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
COPY services ./services

RUN if [ -f package-lock.json ]; then \
      npm ci --workspace services/<SERVICE_NAME> --include-workspace-root; \
    else \
      npm install --workspace services/<SERVICE_NAME> --include-workspace-root; \
    fi

WORKDIR /app/services/<SERVICE_NAME>

RUN DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres npx prisma generate && npm run build

EXPOSE <SERVICE_PORT>

CMD ["sh", "-c", "npx prisma migrate deploy && npm start"]
