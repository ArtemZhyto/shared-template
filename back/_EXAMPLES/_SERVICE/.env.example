# ============================================================================
# <PROJECT_DISPLAY_NAME> / <SERVICE_NAME> SERVICE ENVIRONMENT
# ============================================================================
#
# Local development:
#   1. Copy this file to `.env`.
#   2. Replace secret/example values in the copied `.env` file.
#
# Docker production:
#   Create `.env.prod` with the same keys and production-safe values.
#
# Never commit `.env` or `.env.prod`.
# ============================================================================

MODE=dev
DOMAIN=<PROJECT_DOMAIN>
SERVICE_PORT=<SERVICE_PORT>
FRONTEND_URL=http://localhost:<FRONTEND_PORT>

POSTGRES_HOST=localhost
POSTGRES_PORT=<SERVICE_DB_PORT>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=<SERVICE_DB_NAME>

COOKIES_SECRET=replace_with_a_long_random_cookie_secret
REFRESH_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_SECRET=replace_with_a_long_random_access_secret

REFRESH_AGE=2592000000
ACCESS_AGE=900000

EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
