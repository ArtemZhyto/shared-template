# ============================================================================
# <PROJECT_DISPLAY_NAME> BACKEND ENVIRONMENT
# ============================================================================
#
# Local development:
#   1. Copy this file to `.env`.
#   2. Keep MODE=dev.
#
# Docker development:
#   Create `.env.docker` with the override values shown below.
#
# Docker production:
#   Create `.env.prod` with the production override values shown below.
#
# Never commit `.env`, `.env.docker`, or `.env.prod`.
# ============================================================================

MODE=dev
DOMAIN=<PROJECT_DOMAIN>
SERVICE_PORT=<SERVICE_PORT>
FRONTEND_URL=http://localhost:<FRONTEND_PORT>

POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>
POSTGRES_PORT=<POSTGRES_PORT>
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>

COOKIES_SECRET=replace_with_a_long_random_cookie_secret
REFRESH_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_SECRET=replace_with_a_long_random_access_secret

REFRESH_AGE=2592000000
ACCESS_AGE=900000

EMAIL_VERIFICATION_EXPIRES_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# ============================================================================
# `.env.docker` EXAMPLE
# ============================================================================
# MODE=dev
# FRONTEND_URL=http://localhost:<FRONTEND_PORT>
# DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<PROJECT_NAME>_postgres:5432/<POSTGRES_DB>
#
# ============================================================================
# `.env.prod` EXAMPLE
# ============================================================================
# MODE=prod
# FRONTEND_URL=<PUBLIC_FRONTEND_URL>
# DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<PROJECT_NAME>_postgres:5432/<POSTGRES_DB>
# ============================================================================
