# ============================================================================
# <PROJECT_DISPLAY_NAME> FRONTEND ENVIRONMENT
# ============================================================================
#
# Local development:
#   1. Copy this file to `.env`.
#   2. Keep MODE=dev.
#
# Docker production:
#   Create `.env.prod` with the same keys and production values.
#
# `API_URL` is the server-side API address. Docker Compose overrides it with
# <INTERNAL_API_URL>; browser code uses NEXT_PUBLIC_API_URL.
#
# Never commit `.env` or `.env.prod`.
# ============================================================================

MODE=dev
NEXT_PUBLIC_SITE=http://localhost:<FRONTEND_PORT>
NEXT_PUBLIC_API_URL=<PUBLIC_API_URL>
API_URL=<PUBLIC_API_URL>
