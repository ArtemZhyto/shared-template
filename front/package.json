{
  "name": "<PROJECT_NAME>-client",
  "description": "<PROJECT_DESCRIPTION>",
  "version": "1.0.0",
  "author": "Artem_Zhyto <https://github.com/ArtemZhyto>",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p <FRONTEND_PORT>",
    "build": "next build",
    "start": "next start --port <FRONTEND_PORT>",
    "test": "vitest run --passWithNoTests",
    "go": "npm run build && npm start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down --remove-orphans",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down --remove-orphans"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.2",
    "axios": "^1.13.6",
    "lucide-react": "^1.27.0",
    "next": "^15.5.26",
    "next-intl": "^4.14.6",
    "postcss": "^8.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.86.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vitest": "^5.0.2"
  }
}
